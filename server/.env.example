PORT="your desired port number, e.g., 5000"

SUPABASE_URL="https://your-supabase-url.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="Your Supabase service role key here"

OPENAI_API_KEY="Your OpenAI API key here"
AWS_REGION="your AWS region here, e.g., ca-central-1"
AWS_S3_RESUME_BUCKET="your AWS S3 bucket name for resumes here"
# --- Job discovery (optional) ---
# Supabase auth user ID that owns the tracker; used by the scheduler and `npm run discovery`.
DISCOVERY_USER_ID="your Supabase user id (auth.users.id)"
# In-process daily run. Only use on an always-on server; otherwise use the CLI from a cron.
DISCOVERY_SCHEDULE_ENABLED="false"
DISCOVERY_SCHEDULE_TIME="08:00"
DISCOVERY_SCHEDULE_TZ="America/Toronto"
# Optional JSON file overriding src/discovery/board-list.json
# DISCOVERY_BOARDS_FILE="./my-boards.json"
NODE_ENV="development"
